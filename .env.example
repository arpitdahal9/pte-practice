# ─────────────────────────────────────────────────────────────
# PTE Practice Platform — environment variables
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows cmd)  |  Copy-Item .env.example .env (PowerShell)
#
# Database: Cloudflare D1 via wrangler.jsonc binding `DB` (no DATABASE_URL).
# ─────────────────────────────────────────────────────────────

# Auth is disabled in this build. These are unused leftovers and can be blank.
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ADMIN_EMAILS=""

# ── AI scoring: Anthropic Claude ────────────────────────────
# Required for rubric-based scoring. Two ways to authenticate:
#
#   1. OAuth profile (recommended for local dev):
#        ant auth login
#      …and leave ANTHROPIC_API_KEY commented out below.
#
#   2. A static API key from https://console.anthropic.com/ — required for
#      serverless deploys (Vercel), which have no profile on disk.
#
# IMPORTANT: leave the line commented out if you are using an OAuth profile.
# ANTHROPIC_API_KEY="" is not the same as unset. An empty string still occupies
# the highest-priority credential slot and authenticates with an empty key,
# which shadows the profile.
# ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-5"
# Thinking depth / token spend per scoring call: low | medium | high | xhigh | max
ANTHROPIC_EFFORT="medium"

# ── Speech-to-text: OpenAI Whisper ──────────────────────────
# Required for Speaking tasks (audio -> transcript). Get a key at
# https://platform.openai.com/. Without it, speaking transcription
# falls back to a clearly-labeled mock.
OPENAI_API_KEY=""
STT_MODEL="whisper-1"

# When "true", scoring/STT never call external APIs and return clearly-labeled
# heuristic results — for offline dev and CI only.
#
# This is an explicit opt-in and is NOT auto-enabled. If a scoring call fails,
# the app reports the error and marks the attempt unscored; it never quietly
# substitutes a heuristic estimate for a real grade.
SCORING_MOCK="false"

# ── File / audio storage ────────────────────────────────────
# STORAGE_DRIVER = "local" (dev, writes to ./public/uploads)
#                | "s3"    (prod, any S3-compatible bucket)
STORAGE_DRIVER="local"

# Only needed when STORAGE_DRIVER="s3"
S3_ENDPOINT=""            # e.g. https://s3.amazonaws.com or a MinIO/R2 endpoint
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""          # public base URL for stored objects (CDN or bucket URL)
S3_FORCE_PATH_STYLE="true" # true for MinIO/R2, false for AWS S3

# ── Misc ────────────────────────────────────────────────────
