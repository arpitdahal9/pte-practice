// PTE Practice Platform — Prisma schema (SQLite / Cloudflare D1)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Local Prisma CLI / migrate only. Runtime uses @prisma/adapter-d1 + env.DB.
  url      = "file:./dev.db"
}

// ─────────────────────────────────────────────────────────────
// Enums (stored as TEXT on SQLite)
// ─────────────────────────────────────────────────────────────

/// The four PTE skill areas used for the dashboard breakdown.
enum Section {
  SPEAKING
  WRITING
  READING
  LISTENING
}

/// Every supported PTE-style task type.
enum TaskType {
  READ_ALOUD
  REPEAT_SENTENCE
  DESCRIBE_IMAGE
  RETELL_LECTURE
  ANSWER_SHORT_QUESTION
  SUMMARIZE_WRITTEN_TEXT
  WRITE_ESSAY
  RW_FILL_BLANKS
  MCQ_SINGLE_R
  MCQ_MULTI_R
  REORDER_PARAGRAPHS
  R_FILL_BLANKS
  SUMMARIZE_SPOKEN_TEXT
  MCQ_MULTI_L
  L_FILL_BLANKS
  HIGHLIGHT_SUMMARY
  MCQ_SINGLE_L
  SELECT_MISSING_WORD
  HIGHLIGHT_INCORRECT_WORDS
  WRITE_FROM_DICTATION
}

enum Role {
  USER
  ADMIN
}

enum AttemptMode {
  PRACTICE
  MOCK
}

enum ScoreStatus {
  PENDING
  SCORED
  FAILED
}

enum MockTestType {
  FULL
  SECTION
}

// ─────────────────────────────────────────────────────────────
// Auth tables (unused by the open guest build; kept for schema continuity)
// ─────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           Role      @default(USER)
  targetScore    Int?

  accounts     Account[]
  sessions     Session[]
  attempts     Attempt[]
  mockAttempts MockAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────

model Question {
  id           String   @id @default(cuid())
  section      Section
  taskType     TaskType
  title        String
  instructions String?
  promptText   String?
  mediaUrl     String?
  mediaType    String?

  /// Task-specific structured content (see src/lib/pte/schemas.ts).
  payload Json

  difficulty Int     @default(2)
  isSample   Boolean @default(true)
  /// JSON string array, e.g. ["sample"]. Was Postgres String[].
  tags       Json    @default("[]")

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempts      Attempt[]
  mockQuestions MockTestQuestion[]

  @@index([section, taskType])
  @@index([taskType])
}

// ─────────────────────────────────────────────────────────────
// Attempts + scores
// ─────────────────────────────────────────────────────────────

model Attempt {
  id         String      @id @default(cuid())
  userId     String
  questionId String
  mode       AttemptMode @default(PRACTICE)

  responseText     String?
  responseAudioUrl String?
  transcript       String?

  responseData Json?

  durationSec Int?

  mockAttemptId String?
  mockAttempt   MockAttempt? @relation(fields: [mockAttemptId], references: [id], onDelete: SetNull)

  score Score?

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([questionId])
  @@index([mockAttemptId])
}

model Score {
  id        String      @id @default(cuid())
  attemptId String      @unique
  status    ScoreStatus @default(SCORED)

  overall Int

  breakdown Json

  feedback String
  /// JSON string arrays. Were Postgres String[].
  strengths    Json @default("[]")
  improvements Json @default("[]")

  rawResponse   Json?
  scorerModel   String?
  scorerVersion String  @default("v1")
  error         String?

  createdAt DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Mock tests
// ─────────────────────────────────────────────────────────────

model MockTest {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        MockTestType @default(SECTION)
  section     Section?
  isSample    Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions MockTestQuestion[]
  attempts  MockAttempt[]
}

model MockTestQuestion {
  id         String @id @default(cuid())
  mockTestId String
  questionId String
  order      Int

  mockTest MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([mockTestId, questionId])
  @@index([mockTestId])
}

model MockAttempt {
  id          String    @id @default(cuid())
  userId      String
  mockTestId  String
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  sectionScores Json?
  overallScore  Int?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTest MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([userId])
  @@index([mockTestId])
}
